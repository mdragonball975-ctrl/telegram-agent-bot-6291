# Copy to .env for local runs. On Railway, set these under Service -> Variables.
# NEVER commit real values.
BOT_TOKEN=
ADMIN_IDS=
MONGO_URI=
MONGO_DATABASE=private_agent
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_MAX_RPM=30
LOG_CHANNEL=
UPDATE_CHANNEL=
API_ID=
API_HASH=
WORKSPACE_DIR=/app/workspace
WORKER_COUNT=8
POLL_SECONDS=1
LEASE_SECONDS=600
MAX_ATTEMPTS=15
MAX_AGENT_STEPS=100
MAX_FILE_BYTES=10000000
MAX_TASK_CHARS=50000
PROGRESS_INTERVAL_SECONDS=2
HEARTBEAT_SECONDS=180
REQUEST_TIMEOUT_SECONDS=300
TELEGRAM_MESSAGE_MAX_LENGTH=4000
HISTORY_LIMIT=50
MAX_TOOL_RESULT_CHARS=50000
PYTHON_EXEC_TIMEOUT=60
LOG_LEVEL=DEBUG
